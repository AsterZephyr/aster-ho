{
	"name": "@ho/cli",
	"version": "0.1.0",
	"description": "CLI tool for ho observability framework",
	"type": "module",
	"bin": { "ho": "./dist/index.js" },
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": ["dist"],
	"scripts": { "build": "tsup", "test": "vitest run", "clean": "rm -rf dist" },
	"dependencies": {
		"@ho/sdk": "workspace:*",
		"@ho/exporter-file": "workspace:*",
		"@ho/exporter-prometheus": "workspace:*",
		"@ho/enricher-cost": "workspace:*",
		"@ho/enricher-error-classify": "workspace:*",
		"@ho/alert-processor": "workspace:*",
		"@ho/baseline": "workspace:*",
		"@ho/ticket-provider": "workspace:*",
		"@ho/context-rot": "workspace:*",
		"@opentelemetry/api": "^1.9.1",
		"@opentelemetry/sdk-trace-base": "^2.7.1",
		"@opentelemetry/core": "^2.7.1",
		"commander": "^12.0.0",
		"yaml": "^2.4.0"
	},
	"devDependencies": { "tsup": "^8.3.0", "typescript": "^5.5.0", "vitest": "^2.1.0" }
}
