{
	"uid": "ho-overview",
	"title": "Ho: Overview",
	"tags": ["ho", "observability"],
	"timezone": "browser",
	"schemaVersion": 39,
	"version": 1,
	"refresh": "30s",
	"time": {
		"from": "now-1h",
		"to": "now"
	},
	"templating": {
		"list": [
			{
				"name": "model",
				"type": "query",
				"datasource": { "type": "prometheus", "uid": "prometheus" },
				"query": "label_values(ho_span_count, model)",
				"refresh": 2,
				"includeAll": true,
				"multi": true,
				"current": { "text": "All", "value": "$__all" }
			},
			{
				"name": "service",
				"type": "query",
				"datasource": { "type": "prometheus", "uid": "prometheus" },
				"query": "label_values(ho_span_count, service)",
				"refresh": 2,
				"includeAll": true,
				"multi": true,
				"current": { "text": "All", "value": "$__all" }
			}
		]
	},
	"panels": [
		{
			"type": "row",
			"title": "Throughput & Errors",
			"gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
			"collapsed": false
		},
		{
			"type": "timeseries",
			"title": "Span Rate",
			"gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
			"datasource": { "type": "prometheus", "uid": "prometheus" },
			"fieldConfig": {
				"defaults": {
					"unit": "ops",
					"custom": { "drawStyle": "line", "fillOpacity": 10 }
				},
				"overrides": []
			},
			"targets": [
				{
					"expr": "sum(rate(ho_span_count{model=~\"$model\", service=~\"$service\"}[$__rate_interval]))",
					"legendFormat": "spans/s",
					"refId": "A"
				}
			]
		},
		{
			"type": "timeseries",
			"title": "Error Rate",
			"gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
			"datasource": { "type": "prometheus", "uid": "prometheus" },
			"fieldConfig": {
				"defaults": {
					"unit": "percentunit",
					"custom": { "drawStyle": "line", "fillOpacity": 10 },
					"min": 0,
					"max": 1
				},
				"overrides": []
			},
			"targets": [
				{
					"expr": "sum(rate(ho_error_count{model=~\"$model\", service=~\"$service\"}[$__rate_interval])) / sum(rate(ho_span_count{model=~\"$model\", service=~\"$service\"}[$__rate_interval]))",
					"legendFormat": "error ratio",
					"refId": "A"
				}
			]
		},
		{
			"type": "row",
			"title": "Latency",
			"gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
			"collapsed": false
		},
		{
			"type": "timeseries",
			"title": "Latency P50 / P95 / P99",
			"gridPos": { "h": 8, "w": 24, "x": 0, "y": 10 },
			"datasource": { "type": "prometheus", "uid": "prometheus" },
			"fieldConfig": {
				"defaults": {
					"unit": "s",
					"custom": { "drawStyle": "line", "fillOpacity": 5 }
				},
				"overrides": []
			},
			"targets": [
				{
					"expr": "histogram_quantile(0.50, sum(rate(ho_span_duration_seconds_bucket{model=~\"$model\", service=~\"$service\"}[$__rate_interval])) by (le))",
					"legendFormat": "p50",
					"refId": "A"
				},
				{
					"expr": "histogram_quantile(0.95, sum(rate(ho_span_duration_seconds_bucket{model=~\"$model\", service=~\"$service\"}[$__rate_interval])) by (le))",
					"legendFormat": "p95",
					"refId": "B"
				},
				{
					"expr": "histogram_quantile(0.99, sum(rate(ho_span_duration_seconds_bucket{model=~\"$model\", service=~\"$service\"}[$__rate_interval])) by (le))",
					"legendFormat": "p99",
					"refId": "C"
				}
			]
		},
		{
			"type": "row",
			"title": "Token Usage",
			"gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
			"collapsed": false
		},
		{
			"type": "timeseries",
			"title": "Input Tokens by Model",
			"gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
			"datasource": { "type": "prometheus", "uid": "prometheus" },
			"fieldConfig": {
				"defaults": {
					"unit": "short",
					"custom": { "drawStyle": "line", "fillOpacity": 10, "stacking": { "mode": "normal" } }
				},
				"overrides": []
			},
			"targets": [
				{
					"expr": "sum(rate(ho_input_tokens_total{model=~\"$model\", service=~\"$service\"}[$__rate_interval])) by (model)",
					"legendFormat": "{{model}}",
					"refId": "A"
				}
			]
		},
		{
			"type": "timeseries",
			"title": "Output Tokens by Model",
			"gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 },
			"datasource": { "type": "prometheus", "uid": "prometheus" },
			"fieldConfig": {
				"defaults": {
					"unit": "short",
					"custom": { "drawStyle": "line", "fillOpacity": 10, "stacking": { "mode": "normal" } }
				},
				"overrides": []
			},
			"targets": [
				{
					"expr": "sum(rate(ho_output_tokens_total{model=~\"$model\", service=~\"$service\"}[$__rate_interval])) by (model)",
					"legendFormat": "{{model}}",
					"refId": "A"
				}
			]
		},
		{
			"type": "row",
			"title": "Cost",
			"gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
			"collapsed": false
		},
		{
			"type": "timeseries",
			"title": "Cost Rate by Model (USD/s)",
			"gridPos": { "h": 8, "w": 24, "x": 0, "y": 28 },
			"datasource": { "type": "prometheus", "uid": "prometheus" },
			"fieldConfig": {
				"defaults": {
					"unit": "currencyUSD",
					"custom": { "drawStyle": "line", "fillOpacity": 10, "stacking": { "mode": "normal" } }
				},
				"overrides": []
			},
			"targets": [
				{
					"expr": "sum(rate(ho_cost_usd_total{model=~\"$model\", service=~\"$service\"}[$__rate_interval])) by (model)",
					"legendFormat": "{{model}}",
					"refId": "A"
				}
			]
		}
	]
}
